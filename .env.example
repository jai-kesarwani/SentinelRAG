
# SentinelRAG - Local Development Configuration

# 1. Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME="SentinelRAG API"
APP_VERSION=0.1.0

# 2. MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentinelrag

# 3. ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=sentinelrag_chunks

# 4. Gemini API
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# 5. JWT Authentication
JWT_SECRET=PASTE_YOUR_GENERATED_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinelrag
JWT_AUDIENCE=sentinelrag-client
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Refresh Cookie
REFRESH_COOKIE_NAME=sentinel_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# 6. CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

# 7. Document Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# 8. Logging
LOG_LEVEL=INFO

# 9. Frontend
VITE_API_BASE_URL=
